{
  "name": "argus",
  "version": "0.1.0",
  "private": true,
  "description": "Argus — multi-machine agent management dashboard",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.11.10",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "@nestjs/platform-express>express": "4.22.3",
      "@nestjs/platform-express>body-parser": "1.20.9",
      "@nestjs/platform-express>multer": "2.3.0",
      "@nestjs/config>lodash": "4.18.1",
      "@nestjs/cli>glob": "10.5.0",
      "@nestjs/cli>webpack": "5.104.1",
      "@angular-devkit/core>ajv": "8.18.0",
      "@angular-devkit/core>picomatch": "4.0.7",
      "external-editor>tmp": "0.2.7"
    }
  }
}
